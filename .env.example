# ===== 大模型（OpenAI 兼容接口，国内大模型通用）=====
# 默认用阿里云百炼（通义千问）：
#   注册+拿 Key：https://bailian.console.aliyun.com
#   使用前需在控制台「模型广场」开通 qwen-plus 和 qwen3-vl-plus，并充值少量余额
# 也可换成其他 OpenAI 兼容平台，改 LLM_BASE_URL + 模型名即可：
#   智谱 GLM : https://open.bigmodel.cn/api/paas/v4 （glm-4-flash / glm-4v-flash 免费）
#   DeepSeek : https://api.deepseek.com/v1          （纯文本，无视觉）
#   Kimi     : https://api.moonshot.cn/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=

# 模型名（在对应平台控制台确认可用后填写）
MODEL_OCR=qwen3-vl-plus      # 视觉模型，识别截图
MODEL_ARTICLE=qwen-plus      # 文本模型，写文章

# ===== 备用新闻 API（可选，RSS 源失效时兜底）=====
GNEWS_API_KEY=
NEWS_API_KEY=

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
